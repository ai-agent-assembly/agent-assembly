# pnpm configuration for the DI-API reference client
#
# shamefully-hoist=false (default)
#   Keep pnpm's strict node_modules layout. A phantom dependency here would be
#   worse than a bug: this package's security argument rests on an explicit,
#   auditable dependency set (see test/guards.test.ts), and a hoisted package
#   that nothing declares is exactly what that argument cannot see.
#
# strict-peer-dependencies=false
#   Matches dashboard/.npmrc so the two Node packages in this repo behave the
#   same way under install.

shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
